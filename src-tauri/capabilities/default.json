{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "SchoolBox default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-exists",
    "fs:allow-mkdir"
  ]
}
