# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment / secrets
.env
.env.*
!.env.example

# Rust / Tauri build artefacts
src-tauri/target/

# Offline runtime staged by scripts/stage-windows-runtime.ps1 — the Ollama
# binary, its runners and the model weights are 130 MB to 2.5 GB. The Modelfile
# beside them IS tracked; it is the seed recipe, not a binary.
src-tauri/resources/runtime/*
!src-tauri/resources/runtime/Martha.offline.Modelfile
# Generated by the same script from whatever it staged.
src-tauri/tauri.windows.offline.conf.json

# Monorepo: AI training artifacts (training/)
__pycache__/
*.pyc
.venv/
venv/
training/skoolbox_train.jsonl
training/skoolbox-lora-adapters/
training/skoolbox-merged/
training/*-checkpoints/
# Final GGUF ships via Git LFS (src-tauri/ai/models/) — keep it; ignore stray ones.
training/*.gguf

# Monorepo: RAG inputs & generated index (rag/)
rag/docs/
*.db

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# foglamp scan output (contains edit token — never commit)
.foglamp/

# Generated review packet (rebuild anytime with training/review.py packet).
# The LEDGER dataset/reviews.json IS tracked — it is the sign-off record.
training/review_packet*.html

# Reviewer portal: local wrangler state + deps.
# NOTE: reviewer/public/dataset.json IS tracked (regenerate: review.py export).
reviewer/.wrangler/
reviewer/node_modules/

# Documentation other than the top-level README stays out of this repository.
*.md
!/README.md

# Next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo
